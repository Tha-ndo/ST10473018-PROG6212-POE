@{ ViewData["Title"] = "Access denied"; }
<div class="container">
    <div class="status-page">
        <div class="code"><i class="bi bi-shield-lock"></i></div>
        <h1 class="mt-3">This area is off-course for you</h1>
        <p class="text-muted mx-auto" style="max-width: 32rem;">
            You're logged in as @(CurrentUser.IsOrganiser ? "an Organiser" : "a Participant"), and this page belongs to the other side of the start line.
        </p>
        <a class="btn btn-primary mt-2" href="/"><i class="bi bi-house"></i> Take me to my home page</a>
    </div>
</div>
