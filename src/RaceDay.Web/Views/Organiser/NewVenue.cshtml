@model VenueFormViewModel
@{ ViewData["Title"] = "Add a venue"; }

@section Hero {
<section class="page-band">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li><li class="breadcrumb-item active" aria-current="page">Add venue</li></ol></nav>
        <h1>Add a venue</h1>
        <p class="mb-0 mt-2">Venues are the start/finish locations you choose when creating an event.</p>
    </div>
</section>
}

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <section class="rd-card">
                <div class="rd-card-body">
                    <form asp-action="NewVenue" method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Durban Beachfront Promenade" />
                            <span asp-validation-for="Name"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AddressLine" class="form-label"></label>
                            <input asp-for="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine"></span>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Province" class="form-label"></label>
                                <select asp-for="Province" class="form-select">
                                    <option value="">Choose…</option>
                                    @foreach (var p in new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "North West", "Northern Cape", "Western Cape" })
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                                <span asp-validation-for="Province"></span>
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label">Latitude <span class="text-muted fw-normal">(optional)</span></label>
                                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" placeholder="-29.858680" />
                                <span asp-validation-for="Latitude"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label">Longitude <span class="text-muted fw-normal">(optional)</span></label>
                                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" placeholder="31.021840" />
                                <span asp-validation-for="Longitude"></span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" data-busy-text="Saving…"><i class="bi bi-geo-alt"></i> Save venue</button>
                            <a class="btn btn-light" href="@(Model.ReturnUrl ?? Url.Action("Dashboard"))">Cancel</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
