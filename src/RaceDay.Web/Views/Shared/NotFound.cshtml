@{ ViewData["Title"] = "Page not found"; }
<div class="container">
    <div class="status-page">
        <div class="code">404</div>
        <h1 class="mt-2">Wrong turn on the route</h1>
        <p class="text-muted mx-auto" style="max-width: 32rem;">We couldn't find that page. It may have moved, or the event may no longer exist.</p>
        <a class="btn btn-primary mt-2" href="/"><i class="bi bi-flag"></i> Browse events</a>
    </div>
</div>
