@{
    ViewData["Title"] = "Something went wrong";
    var code = ViewData["StatusCode"] as int? ?? 500;
}
<div class="container">
    <div class="status-page">
        <div class="code">@code</div>
        <h1 class="mt-2">We tripped over a shoelace</h1>
        <p class="text-muted mx-auto" style="max-width: 32rem;">Something went wrong on our side. Please try again, or head back to the start line.</p>
        <a class="btn btn-primary mt-2" href="/"><i class="bi bi-house"></i> Back to RaceDay</a>
    </div>
</div>
