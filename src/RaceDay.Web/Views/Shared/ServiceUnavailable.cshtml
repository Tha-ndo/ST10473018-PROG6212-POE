@{ ViewData["Title"] = "Service unavailable"; }
<div class="container">
    <div class="status-page">
        <div class="code"><i class="bi bi-wifi-off"></i></div>
        <h1 class="mt-3">Taking a water break</h1>
        <p class="text-muted mx-auto" style="max-width: 34rem;">
            We can't reach the RaceDay service right now. Please check that the RaceDay API is running and try again in a moment.
        </p>
        <a class="btn btn-primary mt-2" href="javascript:location.reload()"><i class="bi bi-arrow-clockwise"></i> Try again</a>
    </div>
</div>
